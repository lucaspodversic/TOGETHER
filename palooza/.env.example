# EN: Copy to .env and fill in. Never commit real secrets. / ES: Copiar a .env y completar. Nunca commitear secretos reales.
HOST=127.0.0.1
PORT=4100
# EN: >= 32 random chars (openssl rand -hex 32). / ES: >= 32 caracteres aleatorios.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100
# EN: Web3 is local anvil (31337) or Sepolia (11155111) only. / ES: Web3 solo anvil local o Sepolia.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
BADGE_CONTRACT=
# EN: Gated features — keep false until legal review. / ES: Funciones con compuerta — dejar en false hasta revisión legal.
FEATURE_CASINO_GAMES=false
FEATURE_BETTING=false
FEATURE_TOKEN_REWARDS=false
FEATURE_PAYOUTS=false
FEATURE_MARKETPLACE=false
FEATURE_NFT_MINT=false
